@implements IDisposable
@inject RobotSerialTerminalService SerialTerminal

<section class="robot-terminal" aria-labelledby="robot-terminal-heading">
    <header class="robot-terminal-header">
        <div>
            <span class="terminal-eyebrow">ESP32 USB serial</span>
            <h2 id="robot-terminal-heading">Robot terminal</h2>
        </div>
        <span class="badge @(connectionState.IsConnected ? "text-bg-success" : "text-bg-secondary")">
            @(connectionState.IsConnected ? connectionState.PortName : "Disconnected")
        </span>
    </header>

    <p class="robot-terminal-status">@connectionState.Message</p>
    <div class="robot-terminal-frame">
        <Xterm @ref="terminal" Options="terminalOptions" OnFirstRender="HandleFirstRenderAsync" />
    </div>
</section>

@code {
    private Xterm? terminal;
    private RobotSerialConnectionState connectionState = new(false, null, "Waiting for robot serial.");
    private long lastWrittenSequence;

    private readonly TerminalOptions terminalOptions = new()
    {
        ConvertEOL = true,
        CursorBlink = false,
        DisableStdin = true,
        FontFamily = "Cascadia Mono, Consolas, monospace",
        FontSize = 13,
        Rows = 16,
        Scrollback = 2000,
        Theme = new Theme
        {
            Background = "#09111f",
            Foreground = "#dbeafe",
            BrightBlack = "#64748b",
            Green = "#4ade80",
            Red = "#fb7185",
            Yellow = "#facc15",
            Blue = "#60a5fa",
            Cyan = "#22d3ee"
        }
    };

    protected override void OnInitialized()
    {
        connectionState = SerialTerminal.State;
        SerialTerminal.LineReceived += HandleLineReceived;
        SerialTerminal.StateChanged += HandleStateChanged;
    }

    private async Task HandleFirstRenderAsync()
    {
        if (terminal is null)
        {
            return;
        }

        await terminal.WriteLine($"\u001b[90m{connectionState.Message}\u001b[0m");
        foreach (var line in SerialTerminal.GetSnapshot())
        {
            await WriteLineAsync(line);
        }
    }

    private void HandleLineReceived(object? sender, RobotSerialLine line) =>
        _ = InvokeAsync(() => WriteLineAsync(line));

    private void HandleStateChanged(object? sender, RobotSerialConnectionState updatedState) =>
        _ = InvokeAsync(async () =>
        {
            connectionState = updatedState;
            StateHasChanged();
            if (terminal is not null)
            {
                await terminal.WriteLine($"\u001b[90m{updatedState.Message}\u001b[0m");
            }
        });

    private async Task WriteLineAsync(RobotSerialLine line)
    {
        if (terminal is null || line.Sequence <= lastWrittenSequence)
        {
            return;
        }

        lastWrittenSequence = line.Sequence;
        await terminal.WriteLine($"\u001b[90m[{line.ReceivedAt:HH:mm:ss.fff}]\u001b[0m {line.Text}");
    }

    public void Dispose()
    {
        SerialTerminal.LineReceived -= HandleLineReceived;
        SerialTerminal.StateChanged -= HandleStateChanged;
    }
}
