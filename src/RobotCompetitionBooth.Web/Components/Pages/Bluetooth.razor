@page "/bluetooth"
@implements IDisposable
@inject BluetoothDiscoveryService BluetoothDiscovery
@inject BluetoothConnectionManager BluetoothConnection
@inject WifiCredentialStore WifiCredentials

<PageTitle>Bluetooth devices</PageTitle>

<div class="bluetooth-page">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h1>Bluetooth devices</h1>
            <p class="text-secondary mb-0">
                Pair with a Robobooth and provision its Wi-Fi and live telemetry connection from this server computer.
            </p>
        </div>

        <button class="btn btn-primary" @onclick="ScanAsync" disabled="@(isScanning || connectionState.IsBusy)">
            @if (isScanning)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>Scanning...</span>
            }
            else
            {
                <span>Scan again</span>
            }
        </button>
    </div>

    @if (!wifiStatus.IsConfigured)
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-3" role="alert">
            <span>Wi-Fi settings are required before a Robobooth can be connected.</span>
            <a class="btn btn-sm btn-warning" href="wifi">Open Wi-Fi setup</a>
        </div>
    }
    else
    {
        <div class="alert alert-light border" role="status">
            Saved Wi-Fi network: <strong>@wifiStatus.NetworkName</strong>. Its credentials and the built-in MQTT endpoint will be sent automatically after secure BLE pairing.
        </div>
    }

    <section class="card mb-4" aria-labelledby="connection-heading">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 id="connection-heading" class="h5 mb-0">Server connection</h2>
                    <span class="badge @ConnectionBadgeClass">@FormatPhase(connectionState.Phase)</span>
                </div>
                <p class="mb-0 text-secondary">@connectionState.StatusMessage</p>
            </div>

            @if (connectionState.CanDisconnect)
            {
                <button class="btn btn-outline-danger" @onclick="DisconnectAsync" disabled="@connectionState.IsBusy">
                    Disconnect and forget
                </button>
            }
        </div>
    </section>

    @if (selectedDevice is not null)
    {
        <section class="card border-primary mb-4" aria-labelledby="pairing-heading">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div>
                        <h2 id="pairing-heading" class="h5">Connect to @DisplayName(selectedDevice)</h2>
                        <p class="text-secondary mb-0">
                            Enter the board's pairing code. A three-digit code such as <code>123</code> is sent as
                            the BLE passkey <code>000123</code>.
                        </p>
                    </div>
                    <button class="btn-close" aria-label="Cancel device selection" @onclick="ClearSelection"></button>
                </div>

                <div class="row g-3 align-items-end mt-1">
                    <div class="col-sm-6 col-md-4">
                        <label for="pairing-code" class="form-label">Pairing code</label>
                        <input id="pairing-code"
                               class="form-control"
                               type="password"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               maxlength="6"
                               autocomplete="one-time-code"
                               @bind="pairingCode"
                               @bind:event="oninput"
                               disabled="@connectionState.IsBusy" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-success"
                                @onclick="ConnectSelectedAsync"
                                disabled="@(connectionState.IsBusy || !wifiStatus.IsConfigured)">
                            @if (connectionState.IsBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            }
                            Pair and connect
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(operationMessage))
                {
                    <div class="alert @(operationSucceeded ? "alert-success" : "alert-danger") mt-3 mb-0" role="status">
                        @operationMessage
                    </div>
                }
            </div>
        </section>
    }

    @if (isScanning)
    {
        <div class="alert alert-info" role="status">
            @scanStatus
            Devices may need to be put into pairing mode before they advertise their name.
        </div>
    }
    else if (scanResult is not null)
    {
        <div class="alert @(scanResult.IsAvailable ? "alert-secondary" : "alert-warning")" role="status">
            @scanResult.StatusMessage
        </div>
    }

    @if (!isScanning && scanResult?.Devices.Count > 0)
    {
        <div class="table-responsive rounded border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Device</th>
                        <th scope="col">Address</th>
                        <th scope="col">Type</th>
                        <th scope="col">Paired</th>
                        <th scope="col">Connected</th>
                        <th scope="col">Signal</th>
                        <th scope="col"><span class="visually-hidden">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var device in scanResult.Devices)
                    {
                        <tr @key="device.Id" class="@(IsSelected(device) ? "table-primary" : null)">
                            <td class="fw-semibold">@device.Name</td>
                            <td><code>@device.Address</code></td>
                            <td>@(device.IsLowEnergy ? "Bluetooth LE" : "Bluetooth")</td>
                            <td>@FormatState(device.IsPaired)</td>
                            <td>@FormatState(device.IsConnected)</td>
                            <td>@FormatSignal(device.SignalStrength)</td>
                            <td class="text-end">
                                <button class="btn btn-sm @(IsSelected(device) ? "btn-primary" : "btn-outline-primary")"
                                        @onclick="() => SelectDevice(device)"
                                        disabled="@(!device.IsLowEnergy || connectionState.IsBusy || !wifiStatus.IsConfigured)">
                                    @(IsSelected(device) ? "Selected" : "Select")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly TimeSpan ScanDuration = TimeSpan.FromSeconds(8);
    private CancellationTokenSource? scanCancellation;
    private BluetoothScanResult? scanResult;
    private BluetoothDeviceInfo? selectedDevice;
    private BluetoothConnectionState connectionState = BluetoothConnectionState.Initial;
    private WifiConfigurationStatus wifiStatus = new(false, null);
    private bool isScanning;
    private bool disposed;
    private bool operationSucceeded;
    private string scanStatus = "Starting Bluetooth scan...";
    private string pairingCode = string.Empty;
    private string? operationMessage;

    private string ConnectionBadgeClass => connectionState.Phase switch
    {
        BluetoothConnectionPhase.Connected => "text-bg-success",
        BluetoothConnectionPhase.Failed => "text-bg-danger",
        BluetoothConnectionPhase.Reconnecting => "text-bg-warning",
        BluetoothConnectionPhase.Disconnected => "text-bg-secondary",
        _ => "text-bg-info"
    };

    protected override void OnInitialized()
    {
        wifiStatus = WifiCredentials.GetStatus();
        connectionState = BluetoothConnection.State;
        BluetoothConnection.StateChanged += OnConnectionStateChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = InvokeAsync(ScanAsync);
        }
    }

    private async Task ScanAsync()
    {
        scanCancellation?.Cancel();
        scanCancellation?.Dispose();
        scanCancellation = new CancellationTokenSource();
        isScanning = true;
        scanResult = null;
        scanStatus = "Starting Bluetooth scan...";
        StateHasChanged();

        try
        {
            var progress = new Progress<string>(message =>
            {
                scanStatus = message;
                StateHasChanged();
            });
            scanResult = await BluetoothDiscovery.ScanAsync(ScanDuration, progress, scanCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            // Navigation away from the page cancels only discovery, never the singleton connection.
        }
        finally
        {
            isScanning = false;
            if (!disposed)
            {
                StateHasChanged();
            }
        }
    }

    private void SelectDevice(BluetoothDeviceInfo device)
    {
        selectedDevice = device;
        pairingCode = string.Empty;
        operationMessage = null;
    }

    private void ClearSelection()
    {
        selectedDevice = null;
        pairingCode = string.Empty;
        operationMessage = null;
    }

    private async Task ConnectSelectedAsync()
    {
        if (selectedDevice is null)
        {
            return;
        }

        operationMessage = null;
        var result = await BluetoothConnection.ConnectAsync(selectedDevice, pairingCode);
        if (disposed)
        {
            return;
        }

        operationSucceeded = result.Succeeded;
        operationMessage = result.Message;
        if (result.Succeeded)
        {
            pairingCode = string.Empty;
        }
    }

    private async Task DisconnectAsync()
    {
        operationMessage = null;
        var result = await BluetoothConnection.DisconnectAsync();
        if (disposed)
        {
            return;
        }

        operationSucceeded = result.Succeeded;
        operationMessage = result.Message;
    }

    private void OnConnectionStateChanged(object? sender, BluetoothConnectionState updatedState)
    {
        if (disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            connectionState = updatedState;
            StateHasChanged();
        });
    }

    private bool IsSelected(BluetoothDeviceInfo device) =>
        string.Equals(selectedDevice?.Address, device.Address, StringComparison.OrdinalIgnoreCase);

    private static string DisplayName(BluetoothDeviceInfo device) =>
        device.Name == "Unknown device" ? device.Address : device.Name;

    private static string FormatPhase(BluetoothConnectionPhase phase) => phase switch
    {
        BluetoothConnectionPhase.Reconnecting => "Reconnecting",
        _ => phase.ToString()
    };

    private static string FormatState(bool? state) => state switch
    {
        true => "Yes",
        false => "No",
        null => "Unknown"
    };

    private static string FormatSignal(short? strength) =>
        strength is null ? "Unknown" : $"{strength} dBm";

    public void Dispose()
    {
        disposed = true;
        BluetoothConnection.StateChanged -= OnConnectionStateChanged;
        scanCancellation?.Cancel();
        scanCancellation?.Dispose();
    }
}
