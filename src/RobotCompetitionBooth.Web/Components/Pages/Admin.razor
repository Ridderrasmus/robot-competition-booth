@page "/admin"
@inject AdminAccessService AdminAccess
@inject NavigationManager Navigation

<PageTitle>Admin</PageTitle>

<AdminGate>
    <div class="admin-page">
        <header class="admin-header">
            <div>
                <span class="admin-eyebrow">Protected settings</span>
                <h1 class="mb-1">Admin</h1>
                <p class="text-secondary mb-0">Manage server-side setup, saved programs, and robot diagnostics.</p>
            </div>
            <button class="btn btn-outline-secondary" type="button" @onclick="LockAdmin">
                Lock admin
            </button>
        </header>

        <div class="admin-settings-grid">
            <a class="admin-setting-card" href="/admin/wifi">
                <span class="admin-setting-icon wifi-icon" aria-hidden="true"></span>
                <span>
                    <strong>Wi-Fi setup</strong>
                    <span>Choose and securely save the network provisioned to Robobooth devices.</span>
                </span>
                <span class="admin-setting-arrow" aria-hidden="true">→</span>
            </a>

            <a class="admin-setting-card" href="/admin/bluetooth">
                <span class="admin-setting-icon bluetooth-icon" aria-hidden="true"></span>
                <span>
                    <strong>Bluetooth setup</strong>
                    <span>Discover, pair, provision, disconnect, and forget Robobooth devices.</span>
                </span>
                <span class="admin-setting-arrow" aria-hidden="true">→</span>
            </a>

            <a class="admin-setting-card" href="/admin/programs">
                <span class="admin-setting-icon programs-icon" aria-hidden="true"></span>
                <span>
                    <strong>Saved programs</strong>
                    <span>Download workspace backups or remove programs stored on this server.</span>
                </span>
                <span class="admin-setting-arrow" aria-hidden="true">→</span>
            </a>

            <a class="admin-setting-card" href="/admin/terminal">
                <span class="admin-setting-icon terminal-icon" aria-hidden="true"></span>
                <span>
                    <strong>Robot terminal</strong>
                    <span>View the live USB serial log from the connected robot.</span>
                </span>
                <span class="admin-setting-arrow" aria-hidden="true">→</span>
            </a>

            <a class="admin-setting-card" href="/admin/firmware">
                <span class="admin-setting-icon firmware-icon" aria-hidden="true"></span>
                <span>
                    <strong>Firmware flashing</strong>
                    <span>Build and upload the Robobooth firmware through a server COM port.</span>
                </span>
                <span class="admin-setting-arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</AdminGate>

@code {
    private void LockAdmin()
    {
        AdminAccess.Lock();
        Navigation.NavigateTo("/admin", replace: true);
    }
}
