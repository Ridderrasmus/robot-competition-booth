@page "/devices"
@implements IDisposable
@inject RobotDeviceStateService DeviceState

<PageTitle>Live devices</PageTitle>

<div class="devices-page">
    <header class="devices-header">
        <div>
            <h1>Live devices</h1>
            <p class="text-secondary mb-0">Select a connected robot to open its programming workspace.</p>
        </div>
        <span class="device-count">
            @devices.Count @(devices.Count == 1 ? "device" : "devices") connected
        </span>
    </header>

    @if (devices.Count == 0)
    {
        <section class="empty-state" aria-labelledby="no-devices-heading">
            <span class="empty-device-icon" aria-hidden="true"></span>
            <h2 id="no-devices-heading" class="h4">No robots are connected</h2>
            <p class="text-secondary mb-3">
                An administrator can configure Wi-Fi and connect a Robobooth from the protected Admin page.
            </p>
            <a class="btn btn-outline-primary" href="/admin">Open admin</a>
        </section>
    }
    else
    {
        <div class="device-list" aria-live="polite">
            @foreach (var device in devices)
            {
                <article class="device-row" @key="device.DeviceId">
                    <span class="device-icon" aria-hidden="true"></span>
                    <span class="device-identity">
                        <strong>@device.DeviceName</strong>
                        <code>@device.DeviceId</code>
                    </span>
                    <a class="btn btn-primary"
                       href="@GetProgramUrl(device.DeviceId)">
                        Program device
                    </a>
                </article>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<ConnectedDeviceListItem> devices = [];

    protected override void OnInitialized()
    {
        DeviceState.StateChanged += HandleStateChanged;
        RefreshDevices();
    }

    private void HandleStateChanged(object? sender, EventArgs eventArgs) =>
        _ = InvokeAsync(() =>
        {
            if (RefreshDevices())
            {
                StateHasChanged();
            }
        });

    private bool RefreshDevices()
    {
        var latestDevices = DeviceState.GetDevices()
            .Where(device => device.IsOnline)
            .Select(device => new ConnectedDeviceListItem(device.DeviceId, device.DeviceName))
            .ToArray();
        if (devices.SequenceEqual(latestDevices))
        {
            return false;
        }

        devices = latestDevices;
        return true;
    }

    private static string GetProgramUrl(string deviceId) =>
        $"/devices/{Uri.EscapeDataString(deviceId)}/program";

    public void Dispose() => DeviceState.StateChanged -= HandleStateChanged;

    private sealed record ConnectedDeviceListItem(string DeviceId, string DeviceName);
}
