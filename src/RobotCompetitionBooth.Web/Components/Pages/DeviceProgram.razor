@page "/devices/{DeviceId}/program"
@implements IAsyncDisposable
@inject DeviceProgramStore ProgramStore
@inject RobotDeviceStateService DeviceState
@inject RobotCollaborationService Collaboration
@inject IJSRuntime JavaScript

<PageTitle>@(device is null ? "Device program" : $"Program {device.DeviceName}")</PageTitle>

<div class="program-page">
    <a class="back-link" href="/devices">← Back to live devices</a>

    @if (device is null)
    {
        <section class="alert alert-warning mt-3" role="alert">
            <h1 class="h4 alert-heading">Device not found</h1>
            <p class="mb-0">
                This device is not in the current connected-device list. Return to Live devices and select a device
                from there.
            </p>
        </section>
    }
    else
    {
        <header class="editor-header">
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="mb-0">Program @device.DeviceName</h1>
                <span class="badge rounded-pill @(device.IsOnline ? "text-bg-success" : "text-bg-secondary")">
                    @(device.IsOnline ? "Online" : "Offline")
                </span>
            </div>
            <p class="text-secondary mb-0">
                <code>@device.DeviceId</code> · Saved workspaces are kept separately for this robot.
            </p>
        </header>

        <section class="collaboration-panel" aria-labelledby="collaboration-heading">
            <div class="collaboration-heading">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h2 id="collaboration-heading" class="h5 mb-0">Live editors</h2>
                        <span class="badge text-bg-success">Live</span>
                    </div>
                    <span class="text-secondary small">
                        @collaborators.Count @(collaborators.Count == 1 ? "person" : "people") working on this robot
                    </span>
                </div>

                @if (currentCollaborator is not null)
                {
                    @if (editingDisplayName)
                    {
                        <div class="rename-editor">
                            <label class="visually-hidden" for="collaborator-name">Your display name</label>
                            <input id="collaborator-name"
                                   class="form-control form-control-sm"
                                   maxlength="40"
                                   disabled="@renameInProgress"
                                   @bind="requestedDisplayName"
                                   @bind:event="oninput" />
                            <button class="btn btn-sm btn-primary"
                                    type="button"
                                    disabled="@renameInProgress"
                                    @onclick="RenameCollaboratorAsync">
                                Save name
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    type="button"
                                    disabled="@renameInProgress"
                                    @onclick="CancelRename">
                                Cancel
                            </button>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary"
                                type="button"
                                @onclick="BeginRename">
                            Change my name
                        </button>
                    }
                }
            </div>

            <div class="collaborator-list" aria-live="polite">
                @foreach (var collaborator in collaborators)
                {
                    var isCurrentUser = collaborator.Id == currentCollaborator?.Id;
                    <div class="collaborator-card @(isCurrentUser ? "current-collaborator" : null)"
                         style="--collaborator-color: @collaborator.Color">
                        <span class="collaborator-dot" aria-hidden="true"></span>
                        <span class="collaborator-summary">
                            <span class="collaborator-name">
                                @collaborator.Name
                                @if (isCurrentUser)
                                {
                                    <span class="text-secondary collaborator-you">(you)</span>
                                }
                            </span>
                            <span class="collaborator-selection">
                                @if (collaborator.SelectedBlockDescription is not null)
                                {
                                    <span>Selected: @collaborator.SelectedBlockDescription</span>
                                }
                                else
                                {
                                    <span>In the workspace</span>
                                }
                            </span>
                        </span>
                    </div>
                }
            </div>
        </section>

        <section class="workspace-toolbar" aria-label="Workspace files">
            <div class="workspace-name-field">
                <label class="form-label" for="workspace-name">Workspace file name</label>
                <div class="input-group">
                    <input id="workspace-name"
                           class="form-control"
                           maxlength="85"
                           disabled="@(!workspaceReady || operationInProgress)"
                           @bind="workspaceName"
                           @bind:event="oninput" />
                    <span class="input-group-text">.json</span>
                </div>
            </div>

            <div class="editor-actions">
                <button class="btn btn-outline-secondary"
                        type="button"
                        disabled="@(!workspaceReady || operationInProgress)"
                        @onclick="NewWorkspaceAsync">
                    New
                </button>
                <button class="btn btn-outline-secondary"
                        type="button"
                        disabled="@(!workspaceReady || operationInProgress)"
                        aria-expanded="@showSavedWorkspaces"
                        aria-controls="saved-workspaces"
                        @onclick="ToggleSavedWorkspacesAsync">
                    Load workspace
                    <span class="badge text-bg-secondary">@savedWorkspaces.Count</span>
                </button>
                <button class="btn btn-primary"
                        type="button"
                        disabled="@(!workspaceReady || operationInProgress)"
                        @onclick="SaveAsync">
                    @if (saveInProgress)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    Save
                </button>
            </div>
        </section>

        @if (showSavedWorkspaces)
        {
            <section id="saved-workspaces" class="card saved-workspaces-panel" aria-labelledby="saved-heading">
                <div class="card-header saved-workspaces-heading">
                    <div>
                        <h2 id="saved-heading" class="h5 mb-0">Saved workspaces</h2>
                        <span class="text-secondary small">Only files saved for @device.DeviceName are shown.</span>
                    </div>
                    <button class="btn-close"
                            type="button"
                            aria-label="Close saved workspaces"
                            @onclick="CloseSavedWorkspaces"></button>
                </div>

                @if (savedWorkspaces.Count == 0)
                {
                    <div class="card-body text-secondary">
                        No workspaces have been saved for this robot yet.
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush saved-workspace-list">
                        @foreach (var savedWorkspace in savedWorkspaces)
                        {
                            <button class="list-group-item list-group-item-action saved-workspace-row"
                                    type="button"
                                    disabled="@operationInProgress"
                                    @onclick="() => LoadAsync(savedWorkspace)">
                                <span class="saved-workspace-name">
                                    <strong>@savedWorkspace.Name</strong><span class="text-secondary">.json</span>
                                </span>
                                <span class="saved-workspace-details">
                                    Saved @FormatSavedAt(savedWorkspace.LastSavedAt)
                                </span>
                            </button>
                        }
                    </div>
                }
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert @(statusIsError ? "alert-danger" : "alert-success") status-message"
                 role="@(statusIsError ? "alert" : "status")">
                @statusMessage
            </div>
        }

        <section class="workspace-shell" aria-label="Blockly program editor">
            @if (!workspaceReady)
            {
                <div class="workspace-loading" role="status">
                    <span class="spinner-border" aria-hidden="true"></span>
                    <span>Opening Blockly…</span>
                </div>
            }
            <div id="@WorkspaceElementId" class="blockly-host"></div>
        </section>

        <p class="upload-note mb-0">
            Uploading programs to the device will be added later. For now, each named workspace is saved on the
            server under this robot's device ID.
        </p>
    }
</div>

@code {
    private const string WorkspaceElementId = "device-program-workspace";

    [Parameter]
    public string DeviceId { get; set; } = string.Empty;

    private RobotDeviceState? device;
    private IJSObjectReference? workspaceModule;
    private DotNetObjectReference<DeviceProgram>? collaborationReference;
    private IReadOnlyList<SavedDeviceWorkspaceInfo> savedWorkspaces = [];
    private IReadOnlyList<RobotCollaborator> collaborators = [];
    private readonly Guid collaborationConnectionId = Guid.NewGuid();
    private CollaboratorIdentity? currentCollaborator;
    private string? initializedDeviceId;
    private string workspaceName = "Program 1";
    private string requestedDisplayName = string.Empty;
    private string? statusMessage;
    private long collaborationRevision;
    private bool statusIsError;
    private bool workspaceReady;
    private bool operationInProgress;
    private bool saveInProgress;
    private bool showSavedWorkspaces;
    private bool collaborationJoined;
    private bool collaborationEventsSubscribed;
    private bool editingDisplayName;
    private bool renameInProgress;

    protected override void OnParametersSet()
    {
        device = DeviceState.GetDevice(DeviceId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (device is null || initializedDeviceId == DeviceId)
        {
            return;
        }

        if (initializedDeviceId is not null)
        {
            LeaveCollaborationSession();
            collaborationReference?.Dispose();
            collaborationReference = null;
        }

        workspaceReady = false;
        initializedDeviceId = DeviceId;
        statusMessage = null;
        statusIsError = false;
        showSavedWorkspaces = false;
        savedWorkspaces = [];

        try
        {
            workspaceModule ??= await JavaScript.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/blocklyWorkspace.js");

            SavedDeviceWorkspace? savedWorkspace = null;
            try
            {
                await RefreshSavedWorkspacesAsync();
                var mostRecentWorkspace = savedWorkspaces.FirstOrDefault();
                if (mostRecentWorkspace is not null)
                {
                    savedWorkspace = await ProgramStore.LoadAsync(DeviceId, mostRecentWorkspace.Name);
                }
            }
            catch (Exception exception)
            {
                statusMessage = $"Saved workspaces could not be read, so a blank workspace was opened: {exception.Message}";
                statusIsError = true;
            }

            if (savedWorkspace is not null)
            {
                workspaceName = savedWorkspace.Name;
                statusMessage = $"Loaded {savedWorkspace.Name}.json, saved {FormatSavedAt(savedWorkspace.LastSavedAt)}.";
                statusIsError = false;
            }
            else
            {
                workspaceName = GetNextWorkspaceName();
            }

            await workspaceModule.InvokeVoidAsync(
                "create",
                WorkspaceElementId,
                savedWorkspace?.WorkspaceJson);
            var initialWorkspaceJson = await workspaceModule.InvokeAsync<string>(
                "save",
                WorkspaceElementId);
            var storedIdentity = await workspaceModule.InvokeAsync<StoredCollaboratorIdentity?>(
                "getStoredCollaboratorIdentity");

            SubscribeToCollaborationEvents();
            var joinResult = Collaboration.Join(
                collaborationConnectionId,
                DeviceId,
                storedIdentity,
                initialWorkspaceJson,
                workspaceName);
            collaborationJoined = true;
            currentCollaborator = joinResult.CurrentUser;
            collaborators = joinResult.Collaborators;
            collaborationRevision = joinResult.Revision;
            workspaceName = joinResult.WorkspaceName;
            requestedDisplayName = joinResult.CurrentUser.Name;

            await workspaceModule.InvokeVoidAsync(
                "storeCollaboratorIdentity",
                joinResult.CurrentUser);
            if (joinResult.JoinedExistingSession)
            {
                await workspaceModule.InvokeVoidAsync(
                    "applyRemoteState",
                    WorkspaceElementId,
                    joinResult.WorkspaceJson);
                statusMessage = $"Joined the live {joinResult.WorkspaceName}.json workspace.";
                statusIsError = false;
            }

            collaborationReference = DotNetObjectReference.Create(this);
            await workspaceModule.InvokeVoidAsync(
                "startCollaboration",
                WorkspaceElementId,
                collaborationReference);
            await UpdateRemoteSelectionsAsync();

            workspaceReady = true;
        }
        catch (Exception exception)
        {
            LeaveCollaborationSession();
            UnsubscribeFromCollaborationEvents();
            collaborationReference?.Dispose();
            collaborationReference = null;
            statusMessage = $"The Blockly workspace could not be opened: {exception.Message}";
            statusIsError = true;
        }

        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (workspaceModule is null || !workspaceReady || operationInProgress)
        {
            return;
        }

        operationInProgress = true;
        saveInProgress = true;
        statusMessage = null;

        try
        {
            var workspaceJson = await workspaceModule.InvokeAsync<string>(
                "save",
                WorkspaceElementId);
            var savedWorkspace = await ProgramStore.SaveAsync(
                DeviceId,
                workspaceName,
                workspaceJson);
            workspaceName = savedWorkspace.Name;
            collaborationRevision = Collaboration.UpdateWorkspace(
                collaborationConnectionId,
                workspaceJson,
                savedWorkspace.Name);
            await RefreshSavedWorkspacesAsync();
            statusMessage = $"Saved {savedWorkspace.Name}.json at {FormatSavedAt(savedWorkspace.LastSavedAt)}.";
            statusIsError = false;
        }
        catch (Exception exception)
        {
            statusMessage = $"The workspace could not be saved: {exception.Message}";
            statusIsError = true;
        }
        finally
        {
            saveInProgress = false;
            operationInProgress = false;
        }
    }

    private async Task LoadAsync(SavedDeviceWorkspaceInfo workspaceInfo)
    {
        if (workspaceModule is null || !workspaceReady || operationInProgress)
        {
            return;
        }

        operationInProgress = true;
        statusMessage = null;

        try
        {
            var savedWorkspace = await ProgramStore.LoadAsync(DeviceId, workspaceInfo.Name);
            if (savedWorkspace is null)
            {
                await RefreshSavedWorkspacesAsync();
                statusMessage = $"{workspaceInfo.Name}.json no longer exists.";
                statusIsError = true;
                return;
            }

            await workspaceModule.InvokeVoidAsync(
                "load",
                WorkspaceElementId,
                savedWorkspace.WorkspaceJson);
            workspaceName = savedWorkspace.Name;
            collaborationRevision = Collaboration.UpdateWorkspace(
                collaborationConnectionId,
                savedWorkspace.WorkspaceJson,
                savedWorkspace.Name);
            showSavedWorkspaces = false;
            statusMessage = $"Loaded {savedWorkspace.Name}.json, saved {FormatSavedAt(savedWorkspace.LastSavedAt)}.";
            statusIsError = false;
        }
        catch (Exception exception)
        {
            statusMessage = $"The saved workspace could not be loaded: {exception.Message}";
            statusIsError = true;
        }
        finally
        {
            operationInProgress = false;
        }
    }

    private async Task NewWorkspaceAsync()
    {
        if (workspaceModule is null || !workspaceReady || operationInProgress)
        {
            return;
        }

        operationInProgress = true;
        statusMessage = null;

        try
        {
            await workspaceModule.InvokeVoidAsync("reset", WorkspaceElementId);
            workspaceName = GetNextWorkspaceName();
            var workspaceJson = await workspaceModule.InvokeAsync<string>(
                "save",
                WorkspaceElementId);
            collaborationRevision = Collaboration.UpdateWorkspace(
                collaborationConnectionId,
                workspaceJson,
                workspaceName);
            showSavedWorkspaces = false;
            statusMessage = "Opened a new blank workspace. Give it a name before saving.";
            statusIsError = false;
        }
        catch (Exception exception)
        {
            statusMessage = $"A new workspace could not be opened: {exception.Message}";
            statusIsError = true;
        }
        finally
        {
            operationInProgress = false;
        }
    }

    private async Task ToggleSavedWorkspacesAsync()
    {
        if (showSavedWorkspaces)
        {
            showSavedWorkspaces = false;
            return;
        }

        operationInProgress = true;
        statusMessage = null;

        try
        {
            await RefreshSavedWorkspacesAsync();
            showSavedWorkspaces = true;
        }
        catch (Exception exception)
        {
            statusMessage = $"The saved workspace list could not be loaded: {exception.Message}";
            statusIsError = true;
        }
        finally
        {
            operationInProgress = false;
        }
    }

    private async Task RefreshSavedWorkspacesAsync() =>
        savedWorkspaces = await ProgramStore.ListAsync(DeviceId);

    private void CloseSavedWorkspaces() => showSavedWorkspaces = false;

    private string GetNextWorkspaceName()
    {
        var existingNames = savedWorkspaces
            .Select(workspace => workspace.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        for (var number = 1; ; number++)
        {
            var candidate = $"Program {number}";
            if (!existingNames.Contains(candidate))
            {
                return candidate;
            }
        }
    }

    private static string FormatSavedAt(DateTimeOffset savedAt) =>
        savedAt.ToLocalTime().ToString("g");

    [JSInvokable]
    public Task OnLocalWorkspaceChanged(string workspaceJson)
    {
        if (collaborationJoined)
        {
            collaborationRevision = Collaboration.UpdateWorkspace(
                collaborationConnectionId,
                workspaceJson);
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnLocalSelectionChanged(string? blockId, string? blockDescription)
    {
        if (collaborationJoined)
        {
            Collaboration.UpdateSelection(
                collaborationConnectionId,
                blockId,
                blockDescription);
        }

        return Task.CompletedTask;
    }

    private void SubscribeToCollaborationEvents()
    {
        if (collaborationEventsSubscribed)
        {
            return;
        }

        Collaboration.WorkspaceChanged += OnCollaborationWorkspaceChanged;
        Collaboration.PresenceChanged += OnCollaborationPresenceChanged;
        collaborationEventsSubscribed = true;
    }

    private void UnsubscribeFromCollaborationEvents()
    {
        if (!collaborationEventsSubscribed)
        {
            return;
        }

        Collaboration.WorkspaceChanged -= OnCollaborationWorkspaceChanged;
        Collaboration.PresenceChanged -= OnCollaborationPresenceChanged;
        collaborationEventsSubscribed = false;
    }

    private void LeaveCollaborationSession()
    {
        if (collaborationJoined)
        {
            Collaboration.Leave(collaborationConnectionId);
            collaborationJoined = false;
        }

        currentCollaborator = null;
        collaborators = [];
    }

    private void OnCollaborationWorkspaceChanged(
        object? sender,
        WorkspaceCollaborationUpdate update)
    {
        if (update.DeviceId != DeviceId ||
            update.SourceConnectionId == collaborationConnectionId ||
            update.Revision <= collaborationRevision)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (workspaceModule is null || !collaborationJoined ||
                update.Revision <= collaborationRevision)
            {
                return;
            }

            collaborationRevision = update.Revision;
            await workspaceModule.InvokeVoidAsync(
                "applyRemoteState",
                WorkspaceElementId,
                update.WorkspaceJson);
            if (update.WorkspaceNameChanged)
            {
                workspaceName = update.WorkspaceName;
            }

            await UpdateRemoteSelectionsAsync();
            StateHasChanged();
        });
    }

    private void OnCollaborationPresenceChanged(
        object? sender,
        PresenceCollaborationUpdate update)
    {
        if (update.DeviceId != DeviceId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            collaborators = update.Collaborators;
            await UpdateRemoteSelectionsAsync();
            StateHasChanged();
        });
    }

    private async Task UpdateRemoteSelectionsAsync()
    {
        if (workspaceModule is null || !collaborationJoined)
        {
            return;
        }

        var selections = collaborators
            .Where(collaborator =>
                collaborator.Id != currentCollaborator?.Id &&
                collaborator.SelectedBlockId is not null)
            .Select(collaborator => new
            {
                BlockId = collaborator.SelectedBlockId,
                collaborator.Color
            })
            .ToArray();
        await workspaceModule.InvokeVoidAsync(
            "setRemoteSelections",
            WorkspaceElementId,
            selections);
    }

    private void BeginRename()
    {
        requestedDisplayName = currentCollaborator?.Name ?? string.Empty;
        editingDisplayName = true;
    }

    private void CancelRename()
    {
        requestedDisplayName = currentCollaborator?.Name ?? string.Empty;
        editingDisplayName = false;
    }

    private async Task RenameCollaboratorAsync()
    {
        if (!collaborationJoined || renameInProgress)
        {
            return;
        }

        renameInProgress = true;
        try
        {
            currentCollaborator = Collaboration.Rename(
                collaborationConnectionId,
                requestedDisplayName);
            requestedDisplayName = currentCollaborator.Name;
            editingDisplayName = false;
            if (workspaceModule is not null)
            {
                await workspaceModule.InvokeVoidAsync(
                    "storeCollaboratorIdentity",
                    currentCollaborator);
            }
        }
        catch (Exception exception)
        {
            statusMessage = $"Your display name could not be changed: {exception.Message}";
            statusIsError = true;
        }
        finally
        {
            renameInProgress = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        UnsubscribeFromCollaborationEvents();
        LeaveCollaborationSession();

        if (workspaceModule is null)
        {
            collaborationReference?.Dispose();
            collaborationReference = null;
            return;
        }

        try
        {
            await workspaceModule.InvokeVoidAsync("dispose", WorkspaceElementId);
            await workspaceModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit has already ended.
        }
        finally
        {
            collaborationReference?.Dispose();
            collaborationReference = null;
        }
    }
}
