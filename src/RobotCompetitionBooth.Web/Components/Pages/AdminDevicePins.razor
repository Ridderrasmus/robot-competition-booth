@page "/admin/device/{DeviceId}/pins"
@implements IDisposable
@inject RobotDeviceStateService DeviceState
@inject RobotHardwareConfigurationStore HardwareConfigurations
@inject RobotHardwareConfigurationDeploymentService Deployment

<PageTitle>Robot pin mappings</PageTitle>

<AdminGate>
    <div class="robot-hardware-page">
        <a class="d-inline-block mb-3" href="/admin/device">← Back to robots</a>

        @if (!validDeviceId)
        {
            <div class="alert alert-danger">The robot ID in this address is invalid.</div>
        }
        else if (loading)
        {
            <div class="d-flex align-items-center gap-2 text-secondary">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                Loading configuration…
            </div>
        }
        else
        {
            <header class="hardware-page-heading">
                <div>
                    <span class="admin-eyebrow">ESP32-S3-N16R8 hardware</span>
                    <h1 class="mb-1">@(robot?.DeviceName ?? DeviceId)</h1>
                    <code>@DeviceId</code>
                </div>
                <span class="badge @(robot?.IsOnline is true ? "text-bg-success" : "text-bg-secondary")">
                    @(robot?.IsOnline is true ? "Connected" : "Offline")
                </span>
            </header>

            <section class="hardware-add-card">
                <div>
                    <h2>Add a component</h2>
                    <p>Select a known component and the page will add every pin that component requires.</p>
                </div>
                <div class="hardware-add-controls">
                    <select class="form-select" @bind="selectedComponentKey" disabled="@busy">
                        <option value="">Choose a component…</option>
                        @foreach (var component in AvailableComponents)
                        {
                            <option value="@component.Key">@component.Label</option>
                        }
                    </select>
                    <button class="btn btn-primary" type="button" @onclick="AddComponent" disabled="@(busy || string.IsNullOrEmpty(selectedComponentKey))">
                        Add component
                    </button>
                </div>
            </section>

            @if (ConfiguredComponents.Count == 0)
            {
                <section class="hardware-empty-state mt-3">
                    <strong>No components mapped</strong>
                    <span>Add only the devices assembled on this robot. Everything else remains disabled.</span>
                </section>
            }
            else
            {
                <div class="hardware-component-grid">
                    @foreach (var component in ConfiguredComponents)
                    {
                        <fieldset class="hardware-component-card" disabled="@busy" @key="component.Key">
                            <div class="hardware-component-heading">
                                <div>
                                    <legend>@component.Label</legend>
                                    <p>@component.Description</p>
                                </div>
                                <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => RemoveComponent(component)">Remove</button>
                            </div>
                            <div class="hardware-pin-grid">
                                @foreach (var pinDefinition in component.Pins)
                                {
                                    <div>
                                        <label class="form-label" for="pin-@pinDefinition.Key">@pinDefinition.Label</label>
                                        <select id="pin-@pinDefinition.Key"
                                                class="form-select"
                                                value="@FormatPin(configuration.GetPin(pinDefinition.Key))"
                                                @onchange="args => ChangePin(pinDefinition.Key, args)">
                                            <option value="">Choose GPIO…</option>
                                            @foreach (var pin in RobotHardwareConfiguration.GetAvailablePins(pinDefinition.Capability))
                                            {
                                                <option value="@pin" disabled="@IsUsedByAnotherRole(pinDefinition.Key, pin)">GPIO @pin</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }
                </div>
            }

            <p class="hardware-reserved-note">
                GPIO 48 is reserved for the robot status light. Flash/PSRAM, USB, and unsafe output pins are not offered.
            </p>

            @if (ValidationError is { } validationError)
            {
                <div class="alert alert-warning" role="status">@validationError</div>
            }
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert @(messageIsError ? "alert-danger" : "alert-success")" role="status">@message</div>
            }

            <div class="hardware-actions">
                <button class="btn btn-success" type="button" @onclick="SaveAndApplyAsync" disabled="@(busy || ValidationError is not null)">
                    @if (busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Save and apply to robot
                </button>
                <button class="btn btn-outline-secondary" type="button" @onclick="ReloadAsync" disabled="@busy">Reload saved configuration</button>
            </div>
        }
    </div>
</AdminGate>

@code {
    [Parameter]
    public string DeviceId { get; set; } = string.Empty;

    private RobotHardwareConfiguration configuration = RobotHardwareConfiguration.Empty("robotbooth-invalid");
    private RobotDeviceState? robot;
    private string selectedComponentKey = string.Empty;
    private string? message;
    private bool messageIsError;
    private bool loading = true;
    private bool busy;
    private bool validDeviceId;
    private string? initializedDeviceId;

    private IReadOnlyList<RobotHardwareComponentDefinition> ConfiguredComponents => configuration.GetConfiguredComponents();
    private IEnumerable<RobotHardwareComponentDefinition> AvailableComponents =>
        RobotHardwareConfiguration.ComponentDefinitions.Where(component => !configuration.HasComponent(component));
    private string? ValidationError => configuration.Validate();

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(initializedDeviceId, DeviceId, StringComparison.Ordinal))
        {
            return;
        }

        initializedDeviceId = DeviceId;
        DeviceState.StateChanged -= HandleDeviceStateChanged;
        try
        {
            DeviceProgramStore.ValidateDeviceId(DeviceId);
            validDeviceId = true;
        }
        catch (ArgumentException)
        {
            validDeviceId = false;
            loading = false;
            return;
        }

        DeviceState.StateChanged += HandleDeviceStateChanged;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        loading = true;
        message = null;
        messageIsError = false;
        try
        {
            configuration = await HardwareConfigurations.LoadAsync(DeviceId) ?? RobotHardwareConfiguration.Empty(DeviceId);
            robot = DeviceState.GetDevice(DeviceId);
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException)
        {
            configuration = RobotHardwareConfiguration.Empty(DeviceId);
            message = $"The saved configuration could not be loaded: {exception.Message}";
            messageIsError = true;
        }
        finally
        {
            loading = false;
        }
    }

    private void AddComponent()
    {
        if (!RobotHardwareConfiguration.TryGetComponent(selectedComponentKey, out var component) ||
            configuration.HasComponent(component))
        {
            return;
        }

        foreach (var pin in component.Pins)
        {
            configuration.Pins[pin.Key] = -1;
        }
        selectedComponentKey = string.Empty;
        message = null;
    }

    private void RemoveComponent(RobotHardwareComponentDefinition component)
    {
        foreach (var pin in component.Pins)
        {
            configuration.Pins.Remove(pin.Key);
        }
        message = null;
    }

    private void ChangePin(string key, ChangeEventArgs args)
    {
        configuration.Pins[key] = int.TryParse(args.Value?.ToString(), out var pin) ? pin : -1;
        message = null;
    }

    private bool IsUsedByAnotherRole(string key, int pin) =>
        configuration.Pins.Any(pair => pair.Key != key && pair.Value == pin);

    private async Task SaveAndApplyAsync()
    {
        busy = true;
        message = null;
        messageIsError = false;
        try
        {
            var result = await Deployment.SaveAndApplyAsync(configuration);
            message = result.Message;
            messageIsError = !result.Saved || (robot?.IsOnline is true && !result.Applied);
        }
        catch (Exception exception) when (exception is IOException or InvalidOperationException)
        {
            message = exception.Message;
            messageIsError = true;
        }
        finally
        {
            busy = false;
        }
    }

    private void HandleDeviceStateChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(() =>
        {
            robot = DeviceState.GetDevice(DeviceId);
            StateHasChanged();
        });

    private static string FormatPin(int? pin) => pin?.ToString() ?? string.Empty;

    public void Dispose() => DeviceState.StateChanged -= HandleDeviceStateChanged;
}
