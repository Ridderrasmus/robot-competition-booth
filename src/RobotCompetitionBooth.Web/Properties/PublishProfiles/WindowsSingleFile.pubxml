<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>

  <Target Name="BundleWebContentForSingleFile" AfterTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" ExcludeFromSingleFile="false" />
    </ItemGroup>
  </Target>

  <Target
    Name="PrepareStaticWebAssetsForSingleFileBundle"
    BeforeTargets="_ComputeFilesToBundle"
    DependsOnTargets="CopyStaticWebAssetsToPublishDirectory;_SplitPublishStaticWebAssetsByCopyOptions;GenerateStaticWebAssetsPublishManifest" />

  <Target Name="AddStaticWebAssetsToSingleFileBundle" AfterTargets="_SplitPublishStaticWebAssetsByCopyOptions">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_PublishStaticWebAssetsTargetPath)">
        <RelativePath>%(_PublishStaticWebAssetsTargetPath.TargetPath)</RelativePath>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish
        Include="$(StaticWebAssetEndpointsPublishManifestPath)"
        Condition="Exists('$(StaticWebAssetEndpointsPublishManifestPath)')">
        <RelativePath>$(TargetName).staticwebassets.endpoints.json</RelativePath>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="RemoveBundledWebAssetsFromPublishDirectory" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <Delete Files="$(PublishDir)$(TargetName).staticwebassets.endpoints.json;$(PublishDir)web.config" />
  </Target>
</Project>
